# ==============================================================================
# Environment Configuration Template
# COPY this file to .env and adjust values for your local development.
# NEVER commit .env files containing real secrets into the repository.
# ==============================================================================

# Application
APP_ENV=development
APP_PORT=8000
DEBUG=true

# Database (e.g. PostgreSQL with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db

# Security & Tokens
SECRET_KEY=change-this-insecure-key-for-local-development-only

# AI / External Services (if applicable)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
