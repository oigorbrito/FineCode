{
  "name": "@finecode/desktop",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "Desktop GUI for the FineCode coding agent",
  "main": "out/main/index.js",
  "desktopName": "finecode-desktop.desktop",
  "author": "FineCode Contributors",
  "license": "Apache-2.0",
  "homepage": "https://finecode.ai",
  "keywords": [
    "finecode",
    "pi",
    "omp",
    "gui",
    "coding-agent",
    "ai",
    "electron",
    "desktop",
    "ide"
  ],
  "bin": {
    "finecode-desktop": "./bin/finecode-desktop.js",
    "pi-desktop": "./bin/finecode-desktop.js"
  },
  "scripts": {
    "dev": "electron-vite build && electron-vite preview -- --no-sandbox",
    "dev:hot": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src bin scripts resources && node scripts/check-semantic-colors.mjs && i18next-cli lint && i18next-cli extract --ci --dry-run",
    "package": "electron-vite build && electron-builder",
    "package:linux": "electron-vite build && electron-builder --linux",
    "package:linux:appimage": "electron-vite build && electron-builder --linux AppImage",
    "package:linux:all": "electron-vite build && electron-builder --linux",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:mac:dmg": "electron-vite build && electron-builder --mac dmg",
    "package:mac:zip": "electron-vite build && electron-builder --mac zip",
    "package:win": "electron-vite build && electron-builder --win",
    "package:win:nsis": "electron-vite build && electron-builder --win nsis",
    "package:win:portable": "electron-vite build && electron-builder --win portable",
    "package:all": "electron-vite build && electron-builder --linux --mac --win",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "chokidar": "5.0.0",
    "clsx": "2.1.1",
    "codemirror": "6.0.2",
    "i18next": "26.4.4",
    "lucide-react": "0.511.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "style-mod": "4.1.4",
    "yaml": "2.9.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@huggingface/transformers": "4.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.7.9",
    "electron-builder": "26.15.3",
    "electron-vite": "3.1.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "i18next-cli": "1.75.2",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "parakeet.js": "1.4.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "6.4.4"
  },
  "build": {
    "npmRebuild": false,
    "appId": "io.finecode.desktop",
    "productName": "FineCode Desktop",
    "copyright": "Copyright 2026 FineCode Contributors. Licensed under the Apache License, Version 2.0.",
    "files": [
      "out/**/*",
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*",
          "!**/*.test.ts"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "syncDesktopName": true,
      "category": "Development",
      "icon": "resources/icons",
      "synopsis": "Desktop GUI for the FineCode coding agent",
      "description": "An Electron desktop application that provides a GUI frontend for the FineCode coding agent.",
      "maintainer": "FineCode Contributors",
      "artifactName": "FineCode-Desktop-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/Icon.icon",
      "darkModeSupport": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "FineCode Desktop connects to AI providers and development services on your local network."
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "FineCode-Desktop-${version}-${os}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icons/icon.ico",
      "artifactName": "FineCode-Desktop-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FineCode Desktop",
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "artifactName": "FineCode-Desktop-${version}-${os}-${arch}-setup.${ext}"
    }
  }
}
